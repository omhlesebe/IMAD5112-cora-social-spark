
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFF8E1"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cora's Social Sparks ✨"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FF6F00"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stay connected based on time of day"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:id="@+id/etTimeOfDay"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter time: Morning, Afternoon, Dinner..."
            android:inputType="text"
            android:background="#FFFFFF"
            android:padding="12dp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnSuggest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Get My Spark!"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FF6F00"/>

    <TextView
        android:id="@+id/tvSuggestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your spark will appear here..."
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_marginTop="20dp"
        android:minHeight="100dp"/>

    <Button
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reset"
        android:layout_marginTop="12dp"
        android:backgroundTint="#9E9E9E"/>

</LinearLayout>